# Локальная разработка (Vite): можно VITE_* ниже.
# Прод / docker-compose: MAPTILER_KEY + MAPTILER_STYLE в environment контейнера
# (entrypoint пишет /runtime-config.js). Ключ в образ не зашивается.

# Базовый URL API (без /eList — он уже в basePath у swagger)
#VITE_API_BASE_URL=http://92.118.113.6:35028/eList

VITE_USE_MOCK=false

# --- Локально (vite dev) ---
# https://cloud.maptiler.com/
VITE_MAPTILER_KEY=
VITE_MAPTILER_STYLE=streets-v2

# --- Docker Compose (runtime) ---
# MAPTILER_KEY=...
# MAPTILER_STYLE=streets-v2

# Геокодер — через /api/geocode (Nominatim на бэкенде).

#ключ для рекламы яндекс (РСЯ блок R-A-20290944-1, type: feed)
VITE_YANDEX_AD_BLOCK_ID=R-A-20290944-1

# URL для API файлохранилища
#VITE_FILE_STORAGE_URL=http://92.118.113.6:35029/elist/filestorage
